// Copy this file to Secrets.xcconfig and fill in values from
// Supabase dashboard → Project Settings → API.
// Secrets.xcconfig is gitignored, so your keys stay out of git.
//
// Note: xcconfig treats "//" as a comment, so put only the host here
// (no "https://"). The app adds the scheme itself.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key

// Optional: free Unsplash access key for fallback photos (unsplash.com/developers
// → New Application → "Access Key"). Leave as is to skip Unsplash.
UNSPLASH_ACCESS_KEY = your-unsplash-access-key
